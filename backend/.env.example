# ============================================
# Smart Medication Health Tracker - ENV TEMPLATE
# Copy this file to .env and fill in your values
# ============================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Option A: Local MongoDB
MONGO_URI=mongodb://localhost:27017/smart_medication_tracker
# Option B: MongoDB Atlas (cloud) - uncomment and replace with your URI
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart_medication_tracker?retryWrites=true&w=majority

# JWT Secret Key - change this to a long random string in production!
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
