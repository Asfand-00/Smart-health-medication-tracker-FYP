# ============================================
# Smart Medication Health Tracker - ENV TEMPLATE
# Copy this file to .env and fill in your values
# ============================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Option A: Local MongoDB
MONGO_URI=mongodb://localhost:27017/smart_medication_tracker
# Option B: MongoDB Atlas (cloud) - uncomment and replace with your URI
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart_medication_tracker?retryWrites=true&w=majority

# JWT Secret Key - change this to a long random string in production!
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Key used to encrypt prescription documents at rest (AES-256-GCM).
# Any long random string. Falls back to JWT_SECRET when empty.
FILE_ENCRYPTION_KEY=

# Allowed browser origins (comma separated). The mobile app is not affected.
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173,http://localhost:8081

# ── Email (account recovery codes, alerts). Leave empty to log emails to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Smart Medication Tracker <no-reply@example.com>"

# ── SMS via Twilio (optional). Leave empty to log SMS to the console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Development helpers
# In development the password-reset code is returned by the API so the flow
# can be tested without SMTP. Set to false to disable (always off in production).
EXPOSE_RESET_CODE=true
# Set to true to disable rate limiting (automated tests only).
DISABLE_RATE_LIMIT=false
