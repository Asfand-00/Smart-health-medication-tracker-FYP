# ─────────────────────────────────────────────────────────────────────────────
# MedTracker mobile — environment template
# Copy to `.env` (never commit `.env`). Only EXPO_PUBLIC_* variables reach the
# app, and they are embedded in the JavaScript bundle — never put secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# Backend origin (no trailing /api). Leave empty to let `npm start` use this
# computer's LAN IP automatically, which is what a phone on the same Wi-Fi needs.
#   Physical phone / Expo Go : http://<your-computer-LAN-IP>:5000
#   Android emulator         : http://10.0.2.2:5000
#   iOS simulator / web      : http://localhost:5000
#   Deployed backend         : https://api.example.com
EXPO_PUBLIC_API_URL=

# Backend port used for automatic detection when EXPO_PUBLIC_API_URL is empty.
EXPO_PUBLIC_API_PORT=5000
