{
  "expo": {
    "name": "MedTracker",
    "slug": "smart-medication-tracker",
    "version": "1.0.0",
    "scheme": "medtracker",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#020617",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fyp.medtracker"
    },
    "android": {
      "package": "com.fyp.medtracker",
      "adaptiveIcon": {
        "backgroundColor": "#020617",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#020617"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3b82f6",
          "defaultChannel": "reminders"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MedTracker needs access to your photos to attach prescription images.",
          "cameraPermission": "MedTracker uses the camera to photograph prescriptions."
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
